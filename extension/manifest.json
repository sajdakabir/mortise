{
  "manifest_version": 3,
  "name": "Mortise",
  "version": "0.1.0",
  "description": "Fill passwords from your local Mortise vault. Nothing leaves your Mac.",
  "minimum_chrome_version": "116",

  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],

  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["capture.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Mortise",
    "default_icon": { "32": "icons/icon32.png", "128": "icons/icon128.png" }
  },

  "background": { "service_worker": "background.js", "type": "module" },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open Mortise"
    }
  },

  "icons": { "32": "icons/icon32.png", "128": "icons/icon128.png", "256": "icons/icon256.png" }
}
