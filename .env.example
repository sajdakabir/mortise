# Pulled into .env.local by `neon deploy`; never use VITE_ for DB credentials.
DATABASE_URL=postgresql://user:password@your-pooler-host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-host/neondb?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://your-auth-host/neondb/auth
NEON_AUTH_JWKS_URL=https://your-auth-host/neondb/auth/.well-known/jwks.json
NEON_FUNCTION_ACCOUNTS_BASE_URL=https://your-accounts-function/

# Public native OAuth client configured by scripts/configure-neon-auth.mjs.
MORTISE_OIDC_CLIENT_ID=your-public-client-id
MORTISE_OIDC_CALLBACK_PORT=39817
MORTISE_OIDC_RESOURCE=https://your-accounts-function
MORTISE_ACCOUNTS_URL=https://your-accounts-function
# For another OIDC provider, explicitly set MORTISE_OIDC_ISSUER. The server
# otherwise uses NEON_AUTH_BASE_URL. No client secret belongs in the desktop app.
