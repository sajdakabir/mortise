<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for access-controlled (Touch ID) keychain items. Without this,
       SecItemAdd returns errSecMissingEntitlement (-34018) and biometric
       unlock silently cannot be set up. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.truepassword.desktop</string>
  </array>

  <!-- Hardened runtime is mandatory for notarization. The JIT entitlement is
       required by WKWebView, which Tauri uses to render the UI. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Deliberately NOT granted, and each omission is load-bearing:
       - com.apple.security.network.client   : v1 has no sync, so the app has
         no business opening a socket. M6 will need this and should have to
         justify it at that point.
       - com.apple.security.files.user-selected.read-write : no import/export
         yet. M7 adds it.
       - com.apple.security.cs.allow-unsigned-executable-memory and
         .disable-library-validation : these weaken the hardened runtime and
         nothing here needs them. -->
</dict>
</plist>
